// Creates clickable cards in messages that open a separate link.
// 'imageURL', 'title', 'desc' and 'link' are string variables.
window.createCard = function(imageURL = "", title = "", desc = "", link = "") {
  const colors = getRandomColors(); // Generate random colors for each card
  return `<div style="flex:1;min-width:200px;max-width:300px;max-height:120px;padding:1px;border-radius:12px;background:linear-gradient(135deg,${colors.join(',')});box-shadow:0 0 4px #0000007F;"><a href="${link}" style="display:block;width:100%;height:100%;text-decoration:none;color:inherit;" target="_self"><div style="width:100%;height:100%;padding:8px;display:flex;background:#000000BF;border:none;outline:0;border-radius:12px;box-shadow:inset 0 0 4px #0000007F">${imageURL ? '<div style="min-width:50px;min-height:70px;width:50px;height:50px;border-radius:4px;background-position:center;background-size:cover;box-shadow:0 0 4px #0000007F;background-image:url(' + imageURL + ')"></div>' : ''}<div style="padding-left:8px;padding-right:8px;display:flex;flex-direction:column;overflow-y:auto;padding-bottom:16px;mask-image:linear-gradient(to bottom,#000,#000 calc(100% - 16px),transparent);mask-size:100% 100%;mask-position:0 0,100% 0;mask-repeat:no-repeat"><div style="font-weight:700;text-shadow:0 0 4px #0000007F">${title}</div><div style="font-size:80%;opacity:.5;text-shadow:0 0 4px #0000007F">${desc}</div></div></div></a></div>`;
};

// Groups multiple cards together in a grid.
// 'cards' is an array with every card you want, generated using the 'createCard' function.
window.groupCards = function(cards = []) {
  return `<div style="max-width:1024px;padding:8px;display:flex;flex-wrap:wrap;gap:8px">${cards.join("")}</div>`;
};

